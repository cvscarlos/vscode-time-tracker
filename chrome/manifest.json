{
	"manifest_version": 3,
	"name": "Time Tracker nt",
	"version": "1.0.8",
	"description": "Tracks time on the sites you choose and sends it to SolidTime.",
	"background": {
		"service_worker": "dist/background.js",
		"scripts": ["dist/background.js"],
		"type": "module"
	},
	"options_page": "options.html",
	"action": {
		"default_icon": {
			"16": "icons/off-16.png",
			"32": "icons/off-32.png"
		},
		"default_title": "Time Tracker nt"
	},
	"icons": {
		"16": "icons/off-16.png",
		"48": "icons/off-48.png",
		"128": "icons/off-128.png"
	},
	"permissions": ["tabs", "idle", "storage", "alarms", "contextMenus"],
	"host_permissions": ["https://app.solidtime.io/*"],
	"optional_host_permissions": ["https://*/*", "http://*/*"],
	"browser_specific_settings": {
		"gecko": {
			"id": "time-tracker-nt@nokotata",
			"strict_min_version": "140.0",
			"data_collection_permissions": {
				"required": ["browsingActivity"]
			}
		}
	}
}
