{
	"name": "nt-time-tracker",
	"displayName": "Time Tracker nt",
	"icon": "images/icon.png",
	"description": "Automatic, offline-first coding time tracking per project and branch",
	"version": "0.1.7",
	"publisher": "nokotata",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/cvscarlos/vscode-time-tracker.git"
	},
	"engines": {
		"vscode": "^1.105.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "ntTimeTracker.pause",
				"title": "Time Tracker nt: Pause"
			},
			{
				"command": "ntTimeTracker.resume",
				"title": "Time Tracker nt: Resume"
			},
			{
				"command": "ntTimeTracker.showOutput",
				"title": "Time Tracker nt: Show Output"
			},
			{
				"command": "ntTimeTracker.setSolidtimeToken",
				"title": "Time Tracker nt: Set solidtime Token"
			},
			{
				"command": "ntTimeTracker.deleteSolidtimeToken",
				"title": "Time Tracker nt: Delete solidtime Token"
			},
			{
				"command": "ntTimeTracker.setTimetaggerToken",
				"title": "Time Tracker nt: Set TimeTagger Token"
			},
			{
				"command": "ntTimeTracker.deleteTimetaggerToken",
				"title": "Time Tracker nt: Delete TimeTagger Token"
			},
			{
				"command": "ntTimeTracker.syncNow",
				"title": "Time Tracker nt: Sync Now"
			}
		],
		"configuration": {
			"title": "Time Tracker nt",
			"properties": {
				"ntTimeTracker.enabled": {
					"type": "boolean",
					"default": true
				},
				"ntTimeTracker.tracking.idleTimeoutSeconds": {
					"type": "number",
					"default": 120
				},
				"ntTimeTracker.tracking.focusLossToleranceSeconds": {
					"type": "number",
					"default": 25,
					"description": "Seconds a brief look-away is tolerated before a work segment closes."
				},
				"ntTimeTracker.tracking.minimumSegmentSeconds": {
					"type": "number",
					"default": 20
				},
				"ntTimeTracker.solidtime.apiUrl": {
					"type": "string",
					"default": "https://app.solidtime.io",
					"description": "solidtime base URL (cloud or self-hosted)."
				},
				"ntTimeTracker.solidtime.organizationId": {
					"type": "string",
					"default": "",
					"description": "solidtime organization id. Leave blank to use your first organization."
				},
				"ntTimeTracker.timetagger.apiUrl": {
					"type": "string",
					"default": "https://timetagger.app",
					"markdownDescription": "TimeTagger server URL. Leave as the public app, or point to a self-hosted instance. The extension only sends to TimeTagger when a TimeTagger API token is set."
				}
			}
		}
	},
	"scripts": {
		"clean": "rm -rf out",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint src",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"pretest": "npm run clean && npm run compile && npm run lint && npm run format:check",
		"test": "vscode-test",
		"vscode:prepublish": "npm run compile",
		"package": "vsce package --out tmp/"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "22.x",
		"@types/vscode": "^1.105.0",
		"@typescript-eslint/eslint-plugin": "^8.62.0",
		"@typescript-eslint/parser": "^8.62.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0",
		"@vscode/vsce": "^3.9.2",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-unicorn": "^61.0.0",
		"prettier": "^3.8.4",
		"typescript": "^6.0.3"
	}
}
