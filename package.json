{
	"name": "cvs-time-tracker",
	"displayName": "cvs Time Tracker",
	"description": "Automatic, offline-first coding time tracking per project and branch",
	"version": "0.0.1",
	"publisher": "cvscarlos",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/cvscarlos/vscode-clockify-time-tracker.git"
	},
	"engines": {
		"vscode": "^1.105.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "cvsTimeTracker.pause",
				"title": "cvs Time Tracker: Pause"
			},
			{
				"command": "cvsTimeTracker.resume",
				"title": "cvs Time Tracker: Resume"
			},
			{
				"command": "cvsTimeTracker.showOutput",
				"title": "cvs Time Tracker: Show Output"
			}
		],
		"configuration": {
			"title": "cvs Time Tracker",
			"properties": {
				"cvsTimeTracker.enabled": {
					"type": "boolean",
					"default": true
				},
				"cvsTimeTracker.tracking.idleTimeoutSeconds": {
					"type": "number",
					"default": 120
				},
				"cvsTimeTracker.tracking.focusLossGraceMilliseconds": {
					"type": "number",
					"default": 250
				},
				"cvsTimeTracker.tracking.minimumSegmentSeconds": {
					"type": "number",
					"default": 20
				}
			}
		}
	},
	"scripts": {
		"clean": "rm -rf out",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint src",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"pretest": "npm run clean && npm run compile && npm run lint",
		"test": "vscode-test",
		"vscode:prepublish": "npm run compile",
		"package": "vsce package --out tmp/"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "22.x",
		"@types/vscode": "^1.105.0",
		"@typescript-eslint/eslint-plugin": "^8.62.0",
		"@typescript-eslint/parser": "^8.62.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0",
		"@vscode/vsce": "^3.9.2",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-unicorn": "^61.0.0",
		"prettier": "^3.8.4",
		"typescript": "^6.0.3"
	}
}
